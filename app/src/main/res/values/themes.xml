<resources>
    <!-- Light game theme: white base with soft blue -->
    <style name="Base.Theme.SmartTriviaHub" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/wrong</item>
        <item name="android:windowBackground">@color/bg_gradient_end</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SmartTriviaHub" parent="Base.Theme.SmartTriviaHub" />

    <!-- Reusable widget styles -->
    <style name="TitleText">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/primary_dark</item>
    </style>

    <style name="SubtitleText">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="AppCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="backgroundTint">@color/primary</item>
    </style>

    <style name="SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/primary</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <style name="OptionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/option_height</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="strokeColor">@color/option_stroke</item>
        <item name="strokeWidth">@dimen/stroke_width</item>
        <item name="backgroundTint">@color/option_default</item>
    </style>
    <!-- Small outlined buttons for the 50:50 / Hint / Revive lifelines -->
    <style name="LifelineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/lifeline_height</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/lifeline_text</item>
        <item name="android:paddingStart">@dimen/space_xs</item>
        <item name="android:paddingEnd">@dimen/space_xs</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="strokeColor">@color/lifeline_stroke</item>
        <item name="backgroundTint">@color/white</item>
    </style>
</resources>
